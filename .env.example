# ==============================================================================
# EXCALIDRAW MONOREPO - ENVIRONMENT VARIABLES REFERENCE GUIDE
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. FRONTEND APP (apps/web/.env)
# ------------------------------------------------------------------------------
# REST API URL of http-backend
NEXT_PUBLIC_HTTP_URL=http://localhost:3001

# WebSocket URL of ws-backend (use wss:// for production SSL)
NEXT_PUBLIC_WS_URL=ws://localhost:8080

# Google Gemini API key for AI Copilot
GEMINI_API_KEY=your_gemini_api_key_here


# ------------------------------------------------------------------------------
# 2. HTTP BACKEND (apps/http-backend/.env)
# ------------------------------------------------------------------------------
PORT=3001
DATABASE_URL=mongodb://127.0.0.1:27017/excalidraw
MONGODB_URI=mongodb://127.0.0.1:27017/excalidraw
JWT_SECRET=coboard_super_secure_jwt_secret_key_change_me_in_prod

# Render Keep-Alive Auto-Pinger Bot configuration
RENDER_EXTERNAL_URL=https://your-http-backend.onrender.com
KEEP_ALIVE_URLS=https://your-http-backend.onrender.com,https://your-ws-backend.onrender.com


# ------------------------------------------------------------------------------
# 3. WEBSOCKET BACKEND (apps/ws-backend/.env)
# ------------------------------------------------------------------------------
WS_PORT=8080
PORT=8080
DATABASE_URL=mongodb://127.0.0.1:27017/excalidraw
MONGODB_URI=mongodb://127.0.0.1:27017/excalidraw
JWT_SECRET=coboard_super_secure_jwt_secret_key_change_me_in_prod
