{
  "$schema": "https://turbo.build/schema.json",
  "globalEnv": [
    "NEXT_PUBLIC_HTTP_URL",
    "NEXT_PUBLIC_WS_URL",
    "GEMINI_API_KEY",
    "GEMINI_MODEL",
    "DATABASE_URL",
    "MONGODB_URI",
    "JWT_SECRET",
    "PORT",
    "NODE_ENV"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
