{
  "name": "excalidraw-monorepo",
  "private": true,
  "packageManager": "npm@11.17.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "npx turbo run build",
    "dev": "npx turbo run dev",
    "lint": "npx turbo run lint",
    "start:http": "npm run start -w http-backend",
    "start:ws": "npm run start -w ws-backend",
    "start:web": "npm run start -w web"
  },
  "dependencies": {
    "turbo": "^2.10.12",
    "typescript": "^5.7.0"
  }
}
